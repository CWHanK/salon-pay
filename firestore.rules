rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 檢查使用者是否已通過 Firebase 認證登入
    function isAuthenticated() {
      return request.auth != null;
    }

    // 取得當前使用者的個人身分資料
    function getCurrentUserData() {
      return get(/databases/$(database)/documents/salon_users/$(request.auth.uid)).data;
    }

    // 檢查當前登入者是否為店家管理員 (Admin)
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/salon_users/$(request.auth.uid)) &&
        getCurrentUserData().role == 'admin';
    }

    // 驗證管理員授權密鑰 (SHA-256 雜湊比對，伺服器端驗證絕不外洩)
    function isValidAdminSecret(inputHash) {
      return inputHash == 'f365f5a9b76e95c1bf942df99b79063005ccc85a9d96aadbf846aa0ab72cca09' || (
        exists(/databases/$(database)/documents/salon_secrets/admin) &&
        inputHash == get(/databases/$(database)/documents/salon_secrets/admin).data.keyHash
      );
    }

    // 驗證店家註冊密鑰 (SHA-256 雜湊比對，伺服器端驗證絕不外洩)
    function isValidRegistrationSecret(inputHash) {
      return inputHash == '8f48ecba137b707f170ce4fa4970c16ed27cd22a3deb33f558840f830692ef25' || (
        exists(/databases/$(database)/documents/salon_secrets/registration) &&
        inputHash == get(/databases/$(database)/documents/salon_secrets/registration).data.keyHash
      );
    }

    // ==========================================
    // 1. 全店共享沙龍資料 (salon_stores/main_store)
    // ==========================================
    match /salon_stores/{storeId} {
      allow read: if isAuthenticated();

      // 管理員具完整權限；一般員工僅能更新 orders 客單陣列
      allow write: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orders'])
      );
    }

    // ==========================================
    // 2. 獨立管理員機密庫 (salon_secrets/admin, registration)
    // 僅管理員可讀寫，一般員工絕無讀取權限！
    // ==========================================
    match /salon_secrets/{secretId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 3. 使用者身分與註冊名冊 (salon_users/{userId})
    // ==========================================
    match /salon_users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // 建立：員工與管理員皆必須通過店家註冊密鑰比對；註冊為管理員需額外通過管理員密鑰雜湊比對
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        isValidRegistrationSecret(request.resource.data.regKeyHash) && (
          request.resource.data.role == 'staff' ||
          (
            request.resource.data.role == 'admin' &&
            isValidAdminSecret(request.resource.data.adminKeyHash)
          )
        );

      // 更新：管理員可更新；本人可降級為員工；本人升級為管理員需通過密鑰雜湊比對
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && (
          request.resource.data.role == 'staff' ||
          (
            request.resource.data.role == 'admin' &&
            isValidAdminSecret(request.resource.data.adminKeyHash)
          )
        )
      );

      // 刪除：僅管理員可刪除帳號紀錄
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. 個人獨立舊備份相容區 (users/{userId})
    // ==========================================
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 其他未開放的任何集合路徑預設全面封閉
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
